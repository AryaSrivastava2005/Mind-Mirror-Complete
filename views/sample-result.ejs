<%- include('partials/assessment-head',{title:report.title + ' Result'}) %>
<% const percent=Math.round(report.agree/report.total*100); const colors=['thinking','communication','leadership','creativity','adaptability']; %>
<section class="result-hero-card"><div class="result-hero-left"><p class="result-label">Your Sample Test Result</p><h1><%= report.title %></h1><p class="result-description">You agree with <%= report.agree %> of <%= report.total %> statements. Explore your response patterns below.</p><div class="result-badges"><span class="badge badge-blue">15 statements completed</span><span class="badge badge-purple"><%= report.sections.length %> reflection areas</span><span class="badge badge-green">Saved to profile</span></div></div>
<div class="result-hero-right"><div class="donut-card"><svg class="donut-chart" viewBox="0 0 120 120" aria-hidden="true"><circle class="donut-bg" cx="60" cy="60" r="50"></circle><circle class="donut-progress" cx="60" cy="60" r="50" style="stroke-dashoffset:<%= 314-314*percent/100 %>"></circle></svg><div class="donut-text"><strong><%= percent %>%</strong><span><%= report.agree %>/<%= report.total %></span></div></div><p class="donut-caption">Statements agreed with</p></div></section>
<section class="chart-grid"><div class="chart-card wide-card"><p class="mini-label">Chart 1</p><h2>Your Responses by Category</h2><div class="bar-chart"><% report.sections.forEach((s,i)=>{ %><div class="bar-row"><div class="bar-name"><%= s.title %></div><div class="bar-track" aria-hidden="true"><div class="bar-fill <%= colors[i] %>-bar" style="width:<%= s.agree/s.total*100 %>%"></div></div><div class="bar-value"><%= s.agree %>/<%= s.total %></div></div><% }) %></div><p>Bars show statements agreed with in each category.</p></div>
<div class="chart-card"><p class="mini-label">Chart 2</p><h2>Response Summary</h2><div class="summary-stat-list"><div class="summary-stat stat-blue"><span>Agree</span><strong><%= report.agree %></strong></div><div class="summary-stat stat-purple"><span>Disagree</span><strong><%= report.total-report.agree %></strong></div><div class="summary-stat stat-green"><span>Agreement</span><strong><%= percent %>%</strong></div></div></div></section>
<section class="chart-card"><p class="mini-label">Chart 3</p><h2>Reflection Cards</h2><div class="strength-grid sample-strength-grid"><% report.sections.forEach((s,i)=>{ %><div class="strength-card strength-<%= colors[i] %>"><h3><%= s.title %></h3><p><%= Math.round(s.agree/s.total*100) %>%</p><span><%= s.agree %>/<%= s.total %> agree</span></div><% }) %></div></section>
<section class="suggestion-box"><h2>What this result means</h2><p>These percentages describe agreement with statements, not measured strengths, mental health or a diagnosis. Higher agreement is not necessarily better. Categories organise the questions for reflection and are not validated psychological scales.</p></section>
<% report.sections.forEach(s=>{ %><section class="chart-card"><h2><%= s.title %></h2><% if(s.description){ %><p><%= s.description %></p><% } %><% s.items.forEach(q=>{ %><div class="sample-answer"><h3><%= q.text %></h3><p><strong><%= q.answer==='agree'?'Agree':'Disagree' %></strong><% if(q.reflection){ %> — <%= q.reflection %><% } %></p><% if(q.tip){ %><p><strong>Reflection tip:</strong> <%= q.tip %></p><% } %></div><% }) %><% if(s.tip){ %><div class="reflection-tip"><h3>One practical next step</h3><p><%= s.tip %></p></div><% } %></section><% }) %>
<section class="suggestion-box"><div class="action-row"><a class="button" href="/dashboard">Back to Dashboard</a><a class="small-button" href="/sample-tests/<%= report.type %>">Take Test Again</a></div><form action="/sample-tests/result/<%= report.id %>/delete" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Delete This Result</button></form></section></main></div></body></html>
