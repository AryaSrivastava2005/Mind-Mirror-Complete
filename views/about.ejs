<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrf %>">
  <title>About Mind Mirror</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/darkmode.js" defer></script>
  <script src="/js/chatbot.js" defer></script>
  <script src="/js/sidebar.js" defer></script>
</head>
<body class="with-sidebar">
  <%- include('partials/sidebar') %>
  <div class="main-with-sidebar">
    <nav class="navbar glass-navbar utility-navbar">
      <button type="button" id="menuToggle" aria-expanded="false" aria-controls="sideMenu" class="menu-toggle" aria-label="Open menu">☰</button>
      <div class="brand"><a href="/">Mind Mirror</a></div>
      <div class="nav-links">
        <button type="button" id="themeToggle" class="theme-toggle">🌙 Dark Mode</button>
        <% if (!currentUser) { %><a href="/login">Login</a><% } %>
      </div>
    </nav>

    <main class="container page-section">
      <section class="info-hero-card">
        <p class="result-label">About the platform</p>
        <h1>What is Mind Mirror?</h1>
        <p>Mind Mirror is a questionnaire-based wellness website that helps users reflect on their self-reported strengths, view personalized results, and track progress over time.</p>
      </section>

      <section class="info-grid">
        <div class="card">
          <h3>Our Purpose</h3>
          <p>To make self-awareness simple, engaging, and easy to access through a friendly digital experience.</p>
        </div>
        <div class="card">
          <h3>How It Works</h3>
          <p>Users answer questions, the system analyzes response patterns, and results are shown through charts, feedback, and saved history.</p>
        </div>
        <div class="card">
          <h3>Important Note</h3>
          <p>Mind Mirror is a self-awareness tool. It does not replace professional medical or psychological care.</p>
        </div>
      </section>
    </main>
  </div>
  <%- include('partials/chatbot') %>
</body>
</html>
