<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrf %>">
  <title>Contact Mind Mirror</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/darkmode.js" defer></script>
  <script src="/js/chatbot.js" defer></script>
  <script src="/js/sidebar.js" defer></script>
</head>
<body class="with-sidebar">
  <%- include('partials/sidebar') %>
  <div class="main-with-sidebar">
    <nav class="navbar glass-navbar utility-navbar">
      <button type="button" id="menuToggle" aria-expanded="false" aria-controls="sideMenu" class="menu-toggle" aria-label="Open menu">☰</button>
      <div class="brand"><a href="/">Mind Mirror</a></div>
      <div class="nav-links">
        <button type="button" id="themeToggle" class="theme-toggle">🌙 Dark Mode</button>
        <% if (!currentUser) { %><a href="/login">Login</a><% } %>
      </div>
    </nav>

    <main class="container page-section">
      <section class="info-hero-card">
        <p class="result-label">Contact us</p>
        <h1>We would love to hear from you</h1>
        <p>Use this page to share feedback, ask questions about the platform, or suggest improvements.</p>
      </section>

      <section class="info-grid info-grid-two">
        <div class="card">
          <h3>Email</h3>
          <p>support@mindmirror.demo</p>
          <h3>Phone</h3>
          <p>+91 98765 43210</p>
          <h3>Office Hours</h3>
          <p>Monday to Friday, 9:00 AM to 5:00 PM</p>
        </div>
        <div class="card">
          <h3>Sample Contact Form</h3>
          <p>This demo page can later be connected to a working contact form or email service.</p>
          <div class="contact-note">Tip: In the next version, this section can send messages directly to your email or save them in a database.</div>
        </div>
      </section>
    </main>
  </div>
  <%- include('partials/chatbot') %>
</body>
</html>
